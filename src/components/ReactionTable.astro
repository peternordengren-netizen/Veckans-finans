---
/**
 * Kursreaktionen för bolag som rapporterat (scripts/afternoon.py): kurs, dagens förändring, vinst
 * per aktie mot förväntan (samma regler och texter som i rapportutfallen) och mot samma kvartal i
 * fjol. Rader där utfallet var över förväntan men kursen föll, eller under men kursen steg, markeras.
 * Används i eftermiddagen ("Kursreaktion i dag") och i morgonrapporten ("Kursreaktion i går").
 */
import { weekdayDate } from "../lib/calendar";
import type { AfternoonReport } from "../lib/data";
import { shortDate } from "../lib/format";
import { reactionOutcome, type ReportResult } from "../lib/results";
import { signedPct } from "../lib/signals";

interface Props {
  report: AfternoonReport;
  outcomes: Map<string, ReportResult>;
  /** "today": eftermiddagen, "previous": morgonrapportens förra handelsdag. */
  mode: "today" | "previous";
  headingId: string;
  /** Rubriknivå: 3 i eftermiddagen, 2 eller 3 i morgonrapporten. */
  level?: 2 | 3;
}
const { report, outcomes, mode, headingId, level = 3 } = Astro.props;
const H = level === 2 ? "h2" : "h3";
const time = (iso: string) =>
  new Date(iso).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" });
const localDay = (iso: string) => new Date(iso).toLocaleDateString("sv-SE", { timeZone: "Europe/Stockholm" });
const dayTime = (iso: string) => (localDay(iso) === report.date ? time(iso) : `${shortDate(localDay(iso))} ${time(iso)}`);
const price = (v: number | null) =>
  v === null ? "–" : v.toLocaleString("sv-SE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
// Före stängning bara om filen togs fram samma dag som kurserna gäller och före 17:30.
const beforeClose = localDay(report.generated_at) === report.date && time(report.generated_at) < "17:30";
const reacted = report.companies
  .filter((c) => !c.after_close)
  .map((c) => ({ ...c, outcome: reactionOutcome(c.change_pct, outcomes.get(c.ticker)) }));
const afterClose = report.companies.filter((c) => c.after_close);
const divergent = reacted.filter((c) => c.outcome.divergent).length;
const tone = (v: number | null) => (v === null ? "" : v > 0 ? "pos" : v < 0 ? "neg" : "");
const title = mode === "today" ? "Kursreaktion i dag" : `Kursreaktion ${weekdayDate(report.date).toLowerCase()}`;
const dayCol = mode === "today" ? "I dag" : "Dagen";
---

<section class="reaction" aria-labelledby={headingId}>
  <H id={headingId}>{title}</H>
  <p class="note">
    Bolag som rapporterat sedan förra handelsdagens stängning: kursen {beforeClose ? `kl. ${time(report.generated_at)}` : "vid stängning"}{" "}
    mot förra handelsdagens stängning, och vinst per aktie mot förväntan och mot samma kvartal i fjol.
    {report.index.change_pct !== null && ` ${report.index.name}: ${signedPct(report.index.change_pct, 2)}.`}
    {report.price_day === null && reacted.length > 0 && " Yahoo har inga kurser för dagen ännu."}
    {divergent > 0 && <> <span class="flag" aria-hidden="true">⚑</span> = kursen gick mot utfallet ({divergent}).</>}
  </p>
  {report.companies.length === 0 && <p class="empty">Inga rapporter från bolag i bevakningslistan sedan förra handelsdagens stängning.</p>}
  {
    reacted.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Bolag</th>
              <th scope="col">Rapport</th>
              <th scope="col" class="num">Kurs</th>
              <th scope="col" class="num">{dayCol}</th>
              <th scope="col">Mot förväntan</th>
              <th scope="col" class="num">Mot fjol</th>
            </tr>
          </thead>
          <tbody>
            {reacted.map((c) => (
              <tr class:list={{ divergent: c.outcome.divergent }}>
                <th scope="row">
                  {c.outcome.divergent && (
                    <span class="flag" title="Kursen gick mot utfallet">
                      ⚑<span class="sr-only"> Kursen gick mot utfallet: </span>
                    </span>
                  )}
                  <strong>{c.name}</strong> <span class="muted">{c.ticker}</span>
                </th>
                <td>
                  <a href={c.url} rel="noopener noreferrer" target="_blank">
                    {dayTime(c.published)}
                    <span class="sr-only"> – {c.title} (öppnas i ny flik)</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </td>
                <td class="num">{price(c.close)}</td>
                <td class:list={["num", tone(c.change_pct)]}>{signedPct(c.change_pct)}</td>
                <td>
                  {c.outcome.vsExpected ? (
                    <span class:list={["verdict", c.outcome.vsExpected.verdict.replace(" ", "-")]}>
                      {c.outcome.vsExpected.text}
                      {c.outcome.vsExpected.basis === "justerat" && <span class="basis"> (justerat)</span>}
                    </span>
                  ) : (
                    <span class="muted">–</span>
                  )}
                </td>
                <td class="num">{c.outcome.vsLastYear}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {
    afterClose.length > 0 && (
      <p class="note after">
        Efter stängning, reaktionen syns nästa handelsdag:{" "}
        {afterClose.map((c, i) => (
          <>
            {i > 0 && ", "}
            <a href={c.url} rel="noopener noreferrer" target="_blank">
              {c.name} {time(c.published)}
            </a>
          </>
        ))}
        .
      </p>
    )
  }
</section>

<style>
  .reaction {
    padding: 12px 0 8px;
    scroll-margin-top: 8px;
  }
  .reaction > :is(h2, h3) {
    margin: 0 0 6px;
    font-size: 1.1875rem;
  }
  .note,
  .empty,
  .muted {
    color: var(--muted);
  }
  .note {
    margin: 0 0 10px;
    font-size: 0.875rem;
    max-width: 70ch;
  }
  .note.after {
    margin-top: 10px;
  }
  .empty {
    margin: 0 0 8px;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 6px 10px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  thead th {
    background: var(--surface-2);
  }
  tbody th {
    font-weight: normal;
  }
  th.num,
  td.num {
    text-align: right;
  }
  tr.divergent {
    background: var(--banner-bg);
  }
  .flag {
    color: var(--banner-fg);
    font-weight: 700;
    margin-right: 4px;
  }
  .pos {
    color: var(--pos);
  }
  .neg {
    color: var(--neg);
  }
  .verdict {
    font-size: 0.8125rem;
  }
  .verdict.över {
    color: var(--pos);
  }
  .verdict.under {
    color: var(--neg);
  }
  .verdict.kontrollera {
    color: var(--banner-fg);
  }
  .basis {
    color: var(--muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
