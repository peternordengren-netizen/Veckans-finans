---
/** Egen sida för en dags morgonrapport (/morgon/ och /morgon/<datum>/). */
import Base from "../layouts/Base.astro";
import MorningReportView from "./MorningReport.astro";
import { weekdayDate } from "../lib/calendar";
import { formatDate, loadAfternoonBefore, loadResults, type MorningReport } from "../lib/data";

interface Props {
  report: MorningReport;
  dates: string[];
}
const { report, dates } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const time = (iso: string) =>
  new Date(iso).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" });
---

<Base title={`Morgonrapport ${formatDate(report.date)} – Veckans finans`}>
  <main>
    <header class="page-head">
      <div class="wrap">
        <p class="brand"><a href={`${base}/`}>Veckans finans</a></p>
        <div class="title-row">
          <div>
            <h1>Morgonrapport</h1>
            <p class="period">{weekdayDate(report.date)} · sammanställd kl. {time(report.generated_at)}</p>
          </div>
          {
            dates.length > 1 && (
              <nav class="day-nav" aria-label="Välj dag">
                <label for="day-select">Dag</label>
                <select id="day-select" data-day-select>
                  {dates.map((d) => (
                    <option value={`${base}/morgon/${d}/`} selected={d === report.date}>
                      {weekdayDate(d)}
                    </option>
                  ))}
                </select>
              </nav>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap">
      <MorningReportView report={report} results={loadResults(report.date)} reaction={loadAfternoonBefore(report.date)} />
    </div>
  </main>
</Base>

<script>
  document.querySelector<HTMLSelectElement>("[data-day-select]")?.addEventListener("change", (e) => {
    location.href = (e.target as HTMLSelectElement).value;
  });
</script>

<style>
  .page-head {
    padding: 24px 0 16px;
  }
  .brand {
    margin: 0 0 4px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .brand a {
    color: var(--muted);
    text-decoration: none;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    line-height: 1.15;
  }
  .period {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .day-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .day-nav select {
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 8px;
  }
</style>
