{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation.schema.json",
  "title": "Kurs mot vinst i år (scripts/valuation.py, data/valuation/<vecka>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week", "as_of", "year_start", "generated_at", "thresholds", "index", "companies", "errors"],
  "$defs": {
    "num": { "type": ["number", "null"] }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "as_of": { "type": "string", "format": "date" },
    "year_start": { "type": "string", "format": "date" },
    "generated_at": { "type": "string" },
    "mock": { "const": true },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["big_move_pct", "verdict_pct", "pe_max", "eps_change_max_pct", "max_report_age_days", "min_gap_days", "max_gap_days"],
      "properties": {
        "big_move_pct": { "type": "number" },
        "verdict_pct": { "type": "number" },
        "pe_max": { "type": "number" },
        "eps_change_max_pct": { "type": "number" },
        "max_report_age_days": { "type": "integer" },
        "min_gap_days": { "type": "integer" },
        "max_gap_days": { "type": "integer" }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "name", "ytd_pct"],
      "properties": { "ticker": { "type": "string" }, "name": { "type": "string" }, "ytd_pct": { "$ref": "#/$defs/num" } }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "sector", "type", "financial_currency", "price_start", "price_now", "ytd_pct",
          "rel_index_pp", "eps_ttm_start", "eps_ttm_now", "eps_reports_start", "eps_reports_now", "eps_change_pct",
          "pe_start", "pe_now", "pe_change_pct", "pe_over_max", "verdict", "big_moves", "adjusted_ex_dates", "status",
          "event_label"],
        "properties": {
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "sector": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "financial_currency": { "type": ["string", "null"] },
          "price_start": { "$ref": "#/$defs/num" },
          "price_now": { "$ref": "#/$defs/num" },
          "ytd_pct": { "$ref": "#/$defs/num" },
          "rel_index_pp": { "$ref": "#/$defs/num" },
          "eps_ttm_start": { "$ref": "#/$defs/num" },
          "eps_ttm_now": { "$ref": "#/$defs/num" },
          "eps_reports_start": { "type": "array", "items": { "type": "string", "format": "date" } },
          "eps_reports_now": { "type": "array", "items": { "type": "string", "format": "date" } },
          "eps_change_pct": { "$ref": "#/$defs/num" },
          "pe_start": { "$ref": "#/$defs/num" },
          "pe_now": { "$ref": "#/$defs/num" },
          "pe_change_pct": { "$ref": "#/$defs/num" },
          "pe_over_max": { "type": "boolean" },
          "verdict": { "enum": ["kursen före vinsten", "vinsten före kursen", "i takt", null] },
          "big_moves": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "pct"],
              "properties": { "date": { "type": "string", "format": "date" }, "pct": { "type": "number" } }
            }
          },
          "adjusted_ex_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
          "event_label": { "type": ["string", "null"], "description": "Etikett för en känd bolagshändelse som inte går att justera." },
          "status": {
            "enum": ["ok", "kontrollera bolagshändelse", "känd bolagshändelse", "noterad under året", "fastighetsbolag", "investmentbolag", "annan valuta",
              "otillräcklig vinsthistorik", "förlust", "kurs saknas"]
          }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
