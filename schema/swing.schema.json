{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swing.schema.json",
  "title": "Swing: lägesmått och beskrivande etiketter per bolag (scripts/swing.py, data/swing/<datum>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "as_of", "generated_at", "thresholds", "labels", "short_as_of", "companies"],
  "$defs": {
    "num": { "type": ["number", "null"] }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "as_of": { "type": ["string", "null"], "description": "Handelsdagen måtten gäller (förra handelsdagens stängning)." },
    "generated_at": { "type": "string" },
    "mock": { "const": true },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_ratio", "rsi2_low", "rsi2_high", "report_days"],
      "properties": {
        "volume_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "rsi2_low": { "type": "number" },
        "rsi2_high": { "type": "number" },
        "report_days": { "type": "integer", "minimum": 1 }
      }
    },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "short_as_of": { "type": ["string", "null"] },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "sector", "day", "ma20_pct", "ma50_pct", "ma20_over_ma50", "rsi2", "rsi14", "atr_pct",
          "volume_ratio", "above_high20", "report_published", "days_since_report", "report_verdict", "short_pct", "labels"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "sector": { "type": ["string", "null"] },
          "day": { "type": "string" },
          "ma20_pct": { "type": "number" },
          "ma50_pct": { "type": "number" },
          "ma20_over_ma50": { "type": "boolean" },
          "rsi2": { "$ref": "#/$defs/num" },
          "rsi14": { "$ref": "#/$defs/num" },
          "atr_pct": { "$ref": "#/$defs/num" },
          "volume_ratio": { "$ref": "#/$defs/num" },
          "above_high20": { "type": "boolean" },
          "report_published": { "type": ["string", "null"] },
          "days_since_report": { "type": ["integer", "null"] },
          "report_verdict": { "type": ["string", "null"] },
          "short_pct": { "$ref": "#/$defs/num" },
          "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
