{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "Veckans rapportutfall (scripts/results.py, data/results/<vecka>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week", "period", "generated_at", "reports", "missing_batches"],
  "$defs": {
    "comparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["actual", "expected", "analysts", "currency", "surprise_pct", "verdict"],
      "properties": {
        "actual": { "type": "number" },
        "expected": { "type": "number" },
        "analysts": { "type": ["integer", "null"] },
        "currency": { "type": "string" },
        "surprise_pct": { "type": "number" },
        "verdict": { "enum": ["över", "i linje", "under", "osäker konsensus", "bolagshändelse", "teckenbyte", "nära noll", "kontrollera"] },
        "basis": { "enum": ["justerat", "redovisat"], "description": "Resultat per aktie: vilket värde som jämfördes med förväntan (saknas för omsättning och i äldre filer = redovisat)." }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "week": { "type": "string", "pattern": "^(\\d{4}-W\\d{2}|\\d{4}-\\d{2}-\\d{2}(T\\d{4})?)$", "description": "Vecka (måndagens uppsamling), datum (morgonkörning) eller datumThhmm (uppdatering)." },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
    },
    "generated_at": { "type": "string" },
    "mock": { "const": true },
    "missing_batches": { "type": "array", "items": { "type": "integer" } },
    "rejected": {
      "description": "Rapporter som underkändes av valideringen, med första felet som orsak; omgångens övriga rapporter är med i reports (saknas i äldre filer).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "scope", "published", "url", "reason"],
        "properties": {
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "scope": { "type": "string" },
          "published": { "type": "string" },
          "url": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "scope", "sector", "published", "url", "source_name", "raw_file", "period", "note",
          "kpis", "vs_consensus"],
        "properties": {
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "scope": { "type": "string", "pattern": "^(\\d{4}-W\\d{2}|\\d{4}-\\d{2}-\\d{2}(T\\d{4})?)$", "description": "Körningen rapporten kom från: datum (morgon), datumThhmm (uppdatering) eller vecka (måndag)." },
          "sector": { "type": ["string", "null"] },
          "published": { "type": "string" },
          "url": { "type": "string" },
          "source_name": { "type": "string" },
          "raw_file": { "type": "string" },
          "period": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "highlight": {
            "type": ["object", "null"],
            "description": "\"I rapporten\" (se results-batch.schema.json); citaten visas inte. Saknas i äldre filer.",
            "additionalProperties": false,
            "required": ["text", "quotes"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "quotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "tone": { "enum": ["positiv", "blandad", "neutral", "negativ"] }
            }
          },
          "kpis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "value", "unit", "previous_value", "change_pct", "yoy_pct", "period_kind", "quote"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "value": { "type": "number" },
                "unit": { "type": "string" },
                "previous_value": { "type": ["number", "null"] },
                "change_pct": { "type": ["number", "null"], "description": "Rapportens egen procentsats (står i citatet)." },
                "yoy_pct": { "type": ["number", "null"], "description": "Förändring mot föregående år: change_pct, annars uträknad." },
                "period_kind": { "enum": ["kvartal", "delår", "helår"] },
                "quote": { "type": "string" }
              }
            }
          },
          "vs_consensus": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["consensus_date", "eps", "revenue"],
            "properties": {
              "consensus_date": { "type": "string" },
              "uncertain": { "type": "boolean", "description": "Konsensus har varningen \"stor förändring, få analytiker\": utfallet bedöms inte som över/under (saknas i äldre filer = false)." },
              "corporate_event": { "type": "boolean", "description": "Känd bolagshändelse under året (data/corporate_actions.json): ingen procent mot förväntan (saknas i äldre filer = false)." },
              "eps": { "$ref": "#/$defs/comparison" },
              "revenue": { "$ref": "#/$defs/comparison" }
            }
          }
        }
      }
    }
  }
}
